# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# Generated Android web assets and installable build artifacts
/mobile/www/
/mobile/assets/
/output/android/

# Android signing material stays local
*.jks
*.keystore
keystore.properties

# Supply Firebase app configuration and server credentials through deployment setup.
/android/app/google-services.json
*-service-account.json
*firebase-adminsdk*.json
service-account*.json
